# INDI drivers started by indiserver.service. Space-separated.
# Drivers that aren't installed are skipped with a warning (see: journalctl -u indiserver).
# List what's installed with:  ls /usr/bin/indi_*
#
# Defaults:
#   indi_lx200am5     ZWO AM3 / AM5 / AM7 mount (part of libindi)
#   indi_asi_ccd      ZWO ASI cameras, one INDI device per camera (AUR: libindi-asi)
#   indi_asi_wheel    ZWO EFW filter wheel
#   indi_asi_focuser  ZWO EAF focuser
#   indi_asi_rotator  ZWO CAA rotator
# Don't add indi_asi_single_ccd alongside indi_asi_ccd: both would claim the same cameras.
#
# Simulators for testing without hardware:
#   indi_simulator_telescope indi_simulator_ccd indi_simulator_focus indi_simulator_wheel
INDI_DRIVERS="indi_lx200am5 indi_asi_ccd indi_asi_wheel indi_asi_focuser indi_asi_rotator"

# Optional device names, as "driver=Name" separated by ";". The ZWO mount driver calls itself
# "ZWO AM5" whatever the model; AM3 and AM7 owners can rename it. (Changing a name gives the device
# a fresh INDI config, so set its port again and Save in the driver settings.)
#INDI_DEVICE_NAMES="indi_lx200am5=ZWO AM3"
