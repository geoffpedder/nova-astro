[Unit]
Description=Virtual display for headless PHD2 (NOVA)
After=network.target

[Service]
Type=simple
User=NOVA_USER
# Display :99 exists only in memory; no monitor or desktop session needed.
ExecStart=/usr/bin/Xvfb :99 -screen 0 1440x900x24 -nolisten tcp
Restart=on-failure

[Install]
WantedBy=multi-user.target
