// Lets NOVA (running as NOVA_USER) restart or shut down the mini PC from its web page — and nothing else.
// Installed to /etc/polkit-1/rules.d/49-nova-power.rules by deploy/install.sh.
polkit.addRule(function (action, subject) {
    var power = [
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.reboot-ignore-inhibit",
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.power-off-ignore-inhibit",
    ];
    if (subject.user == "NOVA_USER" && power.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
