# NOVA settings. Any key in appsettings.json can be overridden here ("Nova:Backend" -> Nova__Backend).
Nova__Backend=Indi
Nova__IndiHost=localhost
Nova__IndiPort=7624
# Leave empty for ~/Pictures/Nova
Nova__ImageDirectory=
# PHD2's event server (enable in PHD2: Tools > Enable Server)
Nova__Phd2Host=localhost
Nova__Phd2Port=4400
# NOVA as a telescope for Stellarium (Telescope Control > External software or a remote computer); 0 = off.
# Goto: Center (slew + plate solve until centred) or Slew. Equinox must match the telescope's setting in Stellarium.
Nova__StellariumPort=10001
Nova__StellariumGoto=Center
Nova__StellariumEquinox=J2000
Urls=http://0.0.0.0:5000
